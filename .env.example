# Copy this file to .env (git ignores .env) and put ONE key after its equals sign. Free options: Groq (console.groq.com/keys), OpenRouter (openrouter.ai/keys), Google AI Studio.
# If several keys are set the order is Groq, OpenRouter, Gemini; AI_PROVIDER=groq|openrouter|gemini forces one. AI_MODEL overrides the model.
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
